{
  "name": "@playden/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy --env production",
    "types": "wrangler types --include-runtime=false",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply playden --local",
    "db:migrate:remote": "wrangler d1 migrations apply playden --remote --env production",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@playden/engine": "workspace:*",
    "@playden/game-sketch-battle": "workspace:*",
    "@playden/game-tap-race": "workspace:*",
    "@playden/protocol": "workspace:*",
    "arctic": "^3.7.0",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.6.1",
    "@cloudflare/workers-types": "^5.20261109.1",
    "drizzle-kit": "^0.31.11",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0"
  }
}
